<Project Sdk="Microsoft.NET.Sdk">

  <!--
    J&T Express third-party plugin project: create order, order status query, and label print.

    Open-sourced under the MIT License (Copyright Queeny App). See JntExpressPlugin.cs
    for detailed notes.

    Key points:
      1. The assembly name must contain "Plugin" (PluginHost scans by name).
      2. Implement IActivityPlugin from QRpa.Core and call ActivityRegistry.RegisterPlugin(...)
         inside Register().
      3. Output goes straight to samples\plugins: drop the DLL into the plugins folder next to
         any host (Robot/Studio) and it is auto-loaded.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <AssemblyName>JntExpressPlugin</AssemblyName>
    <RootNamespace>JntExpressPlugin</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputPath>$(MSBuildThisFileDirectory)..\plugins\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

</Project>